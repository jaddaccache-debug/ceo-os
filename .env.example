APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
OPENAI_API_KEY=
OPENAI_MODEL=
CEO_NAME=CEO
ALLOW_EXTERNAL_ACTIONS=false
OPENAI_TIMEOUT_SECONDS=20
# Local default is SQLite; docker compose overrides this with Postgres.
DATABASE_URL=sqlite:///./ceoos.db
# Comma-separated names or email addresses whose items get a priority boost.
CEO_KEY_STAKEHOLDERS=investor,board,chair,lead investor
CRM_STALE_DAYS=5
CRM_STALE_MIN_VALUE=50000
GOOGLE_CLIENT_SECRETS=secrets/google_client_secret.json
GOOGLE_TOKEN_PATH=secrets/google_token.json
